{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyLauncher",
  "version": "0.1.0",
  "identifier": "com.lighty.mylauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyLauncher",
        "width": 1100,
        "height": 700,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "backgroundColor": "#1a1a1a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "MyLauncher — офлайн-лаунчер Minecraft",
    "longDescription": "MyLauncher (lighty-launcher): офлайн-запуск Minecraft без аккаунта, автоопределение Java, скачивание JDK с прогрессом.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
